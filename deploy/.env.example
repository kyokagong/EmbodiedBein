EB_DB_PASSWORD=eb-change-me
EB_S3_PASSWORD=eb-minio-change-me
EB_SECRET_KEY=please-change-this-to-a-long-random-string
EB_ADMIN_USER=kk
EB_ADMIN_PASSWORD=embodied
EB_S3_ACCESS_KEY=ebadmin

# Writable host storage. Keep these outside source repositories.
EB_HOST_STATE_DIR=/data/kk/embodiedbein
EB_HOST_MODELS_DIR=/data/kk/models
EB_HOST_ASSETS_DIR=/data/kk/assets
EB_ROBOTWIN_REPO=/data/kk/embodiedbein/sources/robotwin-rlinf-support
EB_ROBOTWIN_ASSETS_ROOT=/data/kk/data/robotwin-assets/981c92aa34d8f94d4cff47e0d5bc2f7d4e0af042
EB_HOST_DATA_DIR=/data/kk/data

# Host-published ports (container-internal ports stay the same).
# Redis still listens on 6380 inside the container (avoid Ray's 6379).
# ebd uses host network, so EB_PORT_REDIS must match the host mapping.
EB_PORT_API=31800
EB_PORT_POSTGRES=5432
EB_PORT_REDIS=6380
EB_PORT_MINIO=9000
EB_PORT_MINIO_CONSOLE=9001
EB_PORT_HTTP=80
EB_PORT_HTTPS=443
EB_PORT_VITE=5173

# Public artifact download endpoint, e.g. https://hf-mirror.com when direct access is unavailable.
EB_HF_ENDPOINT=https://huggingface.co
