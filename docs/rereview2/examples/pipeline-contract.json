{
  "schema_version": "eb.rereview2.design-example.v1",
  "status": "illustrative_not_executable",
  "description": "设计契约示例，不是当前 JobSpec；所有 binding 必须经接入验证后才能编译为作业。",
  "execution": {
    "training_host": "single_host_4x_rtx4090",
    "container_owner": "ebd",
    "redis_port": 6380,
    "task_network": "isolated_namespace",
    "external_sources_read_only": true,
    "code_freeze": "content_snapshot_without_git",
    "physical_release_via_platform": false
  },
  "robot_bindings": [
    {
      "id": "so101_single",
      "family": "so101",
      "variant": "single_arm",
      "physical_hardware_available": true,
      "interface_resolution": "scan_asset_and_device_calibration",
      "source_project": "/data/kk/leisaac",
      "candidate_task": "LeIsaac-SO101-PickOrange-v0",
      "collection_modes": ["scripted_expert", "teleop", "mimic", "policy_rollout"],
      "default_raw_format": "isaac_hdf5_all_attempts",
      "learning_template": "supervised_loop",
      "release_state": "requires_instance_and_target_evidence"
    },
    {
      "id": "g1_edu_sim",
      "family": "unitree_g1",
      "variant": "edu_simulation",
      "physical_hardware_available": false,
      "interface_resolution": "select_asset_hand_and_controller_then_probe",
      "source_project": "/data/kk/IsaacLab",
      "candidate_task": "Isaac-Velocity-Flat-G1-v0",
      "collection_modes": ["controller_rollout", "task_specific_expert_if_verified"],
      "learning_template": "online_rl_loop",
      "required_adapter": "platform_managed_rlinf_g1_env_bridge",
      "release_state": "physical_hardware_unavailable"
    },
    {
      "id": "bhl_fixedhand",
      "family": "berkeley_humanoid_lite",
      "variant": "fixed_hand",
      "physical_hardware_available": true,
      "physical_variant_match": "requires_confirmation",
      "interface_ref": "ee_bhl_fixedhand_10dof_v1",
      "policy_hz": 20,
      "action_dim": 10,
      "observation_concat": false,
      "source_project": "/data/kk/RLinf",
      "candidate_task": "Isaac-Berkeley-Humanoid-Lite-FixedHand-Reach-v0",
      "task_binding_status": "must_validate_against_published_interface",
      "collection_modes": ["qualified_expert", "policy_rollout"],
      "default_raw_format": "lerobot_all_attempts_plus_success_view",
      "learning_template": "supervised_loop",
      "release_state": "requires_instance_and_target_evidence"
    }
  ],
  "collection_budget_example": {
    "status": "illustrative_not_measured",
    "target_accepted_episodes": 100,
    "max_attempts": 300,
    "max_wall_time_seconds": 7200,
    "max_gpu_hours": 2,
    "max_output_bytes": 107374182400,
    "max_concurrent_shards": 1,
    "retain_attempt_ledger": true,
    "publish_when_target_unmet": false
  },
  "artifact_types": [
    "RawArchive", "EpisodeIndex", "DataSlice", "TrainingInput",
    "ModelVersion", "EvalReport", "OptimizationCandidate", "TargetReport", "BundleCandidate"
  ],
  "pipeline_templates": [
    {
      "id": "supervised_loop",
      "revision": 1,
      "external_inputs": {
        "robot_interface": "binding_required",
        "scene_revision": "binding_required",
        "model_recipe": "capability_sft_required",
        "base_model_version": "binding_required",
        "eval_suite": "frozen_binding_required"
      },
      "nodes": [
        {"id": "collect", "operation": "data.collect", "inputs": {}, "outputs": {"raw": "RawArchive"}},
        {"id": "index", "operation": "data.index_validate", "inputs": {"raw": "collect.raw"}, "outputs": {"episodes": "EpisodeIndex"}},
        {"id": "select", "operation": "data.group_split_select", "inputs": {"episodes": "index.episodes"}, "outputs": {"train": "DataSlice", "calibration": "DataSlice"}},
        {"id": "export", "operation": "data.export_and_loader_probe", "inputs": {"train": "select.train"}, "outputs": {"input": "TrainingInput"}},
        {"id": "train", "operation": "train.sft", "inputs": {"data": "export.input"}, "outputs": {"model": "ModelVersion"}},
        {"id": "evaluate", "operation": "eval.sim", "inputs": {"model": "train.model"}, "outputs": {"report": "EvalReport"}}
      ],
      "delivery_inputs": {"model": "train.model", "evaluation": "evaluate.report", "calibration": "select.calibration"}
    },
    {
      "id": "online_rl_loop",
      "revision": 1,
      "external_inputs": {
        "robot_interface": "binding_required",
        "scene_revision": "binding_required",
        "model_recipe": "capability_online_rl_required",
        "reward_revision": "binding_required",
        "eval_suite": "frozen_binding_required"
      },
      "nodes": [
        {"id": "train", "operation": "train.rl", "inputs": {}, "outputs": {"model": "ModelVersion", "sampled_rollouts": "RawArchive"}},
        {"id": "index", "operation": "data.index_validate", "inputs": {"raw": "train.sampled_rollouts"}, "outputs": {"episodes": "EpisodeIndex"}},
        {"id": "select", "operation": "data.calibration_select", "inputs": {"episodes": "index.episodes"}, "outputs": {"calibration": "DataSlice"}},
        {"id": "evaluate", "operation": "eval.sim", "inputs": {"model": "train.model"}, "outputs": {"report": "EvalReport"}}
      ],
      "delivery_inputs": {"model": "train.model", "evaluation": "evaluate.report", "calibration": "select.calibration"}
    }
  ],
  "delivery_template": {
    "id": "target_validated_candidate",
    "target": "jetson_agx_orin_64gb",
    "target_software": "must_probe_actual_device",
    "external_input_types": {"model": "ModelVersion", "evaluation": "EvalReport", "calibration": "DataSlice"},
    "nodes": [
      {"id": "optimize", "operation": "model.export_or_optimize", "inputs": {"model": "$model", "baseline": "$evaluation", "calibration": "$calibration"}, "outputs": {"candidate": "OptimizationCandidate"}},
      {"id": "target", "operation": "external_target_build_and_benchmark", "execution": "human_started_isolated_container", "inputs": {"candidate": "optimize.candidate"}, "outputs": {"report": "TargetReport"}},
      {"id": "reevaluate", "operation": "eval.target_artifact_closed_loop", "execution": "sim_only_with_registered_target_endpoint", "inputs": {"candidate": "optimize.candidate", "target": "target.report"}, "outputs": {"report": "EvalReport"}},
      {"id": "bundle", "operation": "bundle.build_candidate", "inputs": {"candidate": "optimize.candidate", "target": "target.report", "quality": "reevaluate.report"}, "outputs": {"bundle": "BundleCandidate"}}
    ],
    "preconditions": [
      "all_required_nodes_succeeded_with_valid_evidence",
      "actual_target_artifact_hash_matches_target_and_eval_reports",
      "calibration_disjoint_from_acceptance_and_ancestors",
      "quality_and_latency_budgets_met",
      "no_physical_activation_side_effect"
    ]
  },
  "episode_accounting_example": {
    "status": "illustrative_not_measured",
    "attempts": 100,
    "success": 70,
    "failure": 20,
    "timeout": 5,
    "aborted": 3,
    "invalid": 2,
    "accepted_training_episodes": 64,
    "success_rate_denominator": 100,
    "rejection_tags_can_overlap": true
  }
}
