EB_DB_PASSWORD=eb-change-me
EB_S3_PASSWORD=eb-minio-change-me
EB_SECRET_KEY=please-change-this-to-a-long-random-string
EB_ADMIN_USER=kk
EB_ADMIN_PASSWORD=embodied
EB_S3_ACCESS_KEY=ebadmin

# Host-published ports (container-internal ports stay the same).
# Redis still listens on 6380 inside the container (avoid Ray's 6379).
# ebd uses host network, so EB_PORT_REDIS must match the host mapping.
EB_PORT_API=31800
EB_PORT_POSTGRES=5432
EB_PORT_REDIS=6380
EB_PORT_MINIO=9000
EB_PORT_MINIO_CONSOLE=9001
EB_PORT_HTTP=80
EB_PORT_HTTPS=443
EB_PORT_VITE=5173
